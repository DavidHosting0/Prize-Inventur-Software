generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Unit {
  PIECE
  KG
  G
  LITER
  ML
  BOTTLE
  CARTON
  PACK
}

enum SaleStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  FAILED
}

enum MovementType {
  SALE
  PURCHASE
  INVENTORY_ADJUSTMENT
  TRANSFER
  WASTE
  RETURN
  MANUAL_ADJUSTMENT
}

enum PaymentMethod {
  CASH
  CARD
  TWINT
  OFFLINE
  OTHER
}

enum SaleDiscountType {
  NONE
  MANUAL
  VOUCHER_CLUB
  VOUCHER_PREMIUM
  VOUCHER_VIP
  FREE_ITEM
}

enum InventoryCountStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  CLOSED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum AccountType {
  GROUP
  HOTEL
}

model Organization {
  id           String              @id @default(cuid())
  name         String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  hotels       Hotel[]
  users        User[]
  auditLogs    AuditLog[]
  integrations SystemIntegration[]
}

model SystemIntegration {
  id                   String   @id @default(cuid())
  organizationId       String
  provider             String
  purpose              String
  model                String?
  enabled              Boolean  @default(false)
  /// AES-GCM ciphertext of the API key / secret (never returned to clients)
  secretCiphertext     String?
  secretIv             String?
  secretAuthTag        String?
  /// Non-secret settings (limits, endpoints, feature flags)
  settings             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, purpose, provider])
  @@index([organizationId])
}

model Hotel {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// URL segment, e.g. "bern" → /bern/de/dashboard
  slug           String   @unique
  address        String?
  city           String?
  country        String?  @default("CH")
  currency       String   @default("CHF") // ISO 4217
  locale         String   @default("de-CH")
  timezone       String   @default("Europe/Zurich")
  /// Public cover image path under /uploads/hotels/
  imageUrl       String?
  /// POS config: { vouchers: [...], complimentaryReasons: string[] }
  posSettings    Json?
  /// Inventory workflow: review/close policies, liquid presets, etc.
  inventorySettings Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  warehouses   Warehouse[]
  users        UserHotel[]
  products     Product[]
  categories   ProductCategory[]
  suppliers    Supplier[]
  sales        Sale[]
  movements    InventoryMovement[]
  counts       InventoryCount[]
  registers    CashRegister[]
  auditLogs    AuditLog[]
  recipes      Recipe[]
  wastes       Waste[]
  notifications Notification[]
  goodsReceipts GoodsReceipt[]
  purchaseOrders PurchaseOrder[]
  stockTransfers StockTransfer[]
  breakfastRecords BreakfastRecord[]
  minibarRecords MinibarRecord[]
  deliveryNoteScans DeliveryNoteScan[]
  posCategories PosCategory[]
  posArticles   PosArticle[]

  @@index([organizationId])
}

model Warehouse {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel     Hotel              @relation(fields: [hotelId], references: [id])
  stock     StockLevel[]
  movements InventoryMovement[]
  sales     Sale[]
  counts    InventoryCount[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  goodsReceipts GoodsReceipt[]

  @@unique([hotelId, code])
  @@index([hotelId])
}

model Role {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  /// GROUP roles vs HOTEL operational roles
  scope       AccountType @default(HOTEL)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String      @id @default(cuid())
  email          String      @unique
  username       String      @unique
  name           String
  passwordHash   String
  roleId         String
  organizationId String
  accountType    AccountType @default(HOTEL)
  isActive       Boolean     @default(true)
  locale         String      @default("de")
  dashboardPrefs Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  role           Role            @relation(fields: [roleId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  hotels         UserHotel[]
  sales          Sale[]          @relation("SaleCashier")
  movements      InventoryMovement[]
  counts         InventoryCount[]
  auditLogs      AuditLog[]
  cashSessions   CashSession[]
  refunds        Refund[]

  @@index([roleId])
  @@index([organizationId])
  @@index([accountType])
}

model UserHotel {
  userId  String
  hotelId String
  isDefault Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([userId, hotelId])
}

model ProductCategory {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  code      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel    Hotel     @relation(fields: [hotelId], references: [id])
  products Product[]
  counts   InventoryCount[]

  @@unique([hotelId, code])
  @@index([hotelId])
}

model Supplier {
  id               String   @id @default(cuid())
  hotelId          String
  name             String
  address          String?
  contactName      String?
  phone            String?
  email            String?
  leadTimeDays     Int      @default(2)
  minOrderValue    Decimal? @db.Decimal(12, 2)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hotel            Hotel             @relation(fields: [hotelId], references: [id])
  products         Product[]
  supplierProducts SupplierProduct[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  deliveryNoteScans DeliveryNoteScan[]

  @@index([hotelId])
}

model SupplierProduct {
  id            String   @id @default(cuid())
  supplierId    String
  productId     String
  /// Supplier's own article / catalog number (for OCR matching)
  supplierSku   String?
  purchasePrice Decimal  @db.Decimal(12, 4)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([supplierId])
  @@index([productId])
  @@index([supplierId, supplierSku])
}

model Product {
  id            String   @id @default(cuid())
  hotelId       String
  categoryId    String
  supplierId    String?
  name          String
  sku           String
  ean           String?
  barcode       String?
  subcategory   String?
  description   String?
  imageUrl      String?
  unit          Unit     @default(PIECE)
  purchasePrice Decimal  @db.Decimal(12, 4)
  salePrice     Decimal  @db.Decimal(12, 4)
  vatRate       Decimal  @db.Decimal(5, 2) @default(8.1)
  minStock      Decimal  @db.Decimal(12, 3) @default(0)
  optimalStock  Decimal  @db.Decimal(12, 3) @default(0)
  maxStock      Decimal  @db.Decimal(12, 3) @default(0)
  allergens       String[] @default([])
  isActive        Boolean  @default(true)
  trackExpiry     Boolean  @default(false)
  isFavorite      Boolean  @default(false)
  /// When true, stock is kept in ml; bottleContentMl is the pack size for receipts/sales.
  trackLiquid     Boolean  @default(false)
  bottleContentMl Decimal? @db.Decimal(12, 3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel            Hotel             @relation(fields: [hotelId], references: [id])
  category         ProductCategory   @relation(fields: [categoryId], references: [id])
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  stockLevels      StockLevel[]
  movements        InventoryMovement[]
  saleItems        SaleItem[]
  countItems       InventoryCountItem[]
  supplierProducts SupplierProduct[]
  recipeItems      RecipeItem[]
  wastes           Waste[]
  poItems          PurchaseOrderItem[]
  grItems          GoodsReceiptItem[]
  transferItems    StockTransferItem[]
  minibarRecords   MinibarRecord[]
  posArticles      PosArticle[]

  @@unique([hotelId, sku])
  @@index([hotelId])
  @@index([hotelId, name])
  @@index([hotelId, barcode])
  @@index([hotelId, ean])
  @@index([barcode])
  @@index([ean])
  @@index([categoryId])
  @@index([name])
}

model StockLevel {
  id             String   @id @default(cuid())
  productId      String
  warehouseId    String
  quantity       Decimal  @db.Decimal(14, 3) @default(0)
  reservedQty    Decimal  @db.Decimal(14, 3) @default(0)
  lastMovementAt DateTime?
  updatedAt      DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model InventoryMovement {
  id            String       @id @default(cuid())
  hotelId       String
  productId     String
  warehouseId   String
  userId        String?
  type          MovementType
  quantity      Decimal      @db.Decimal(14, 3)
  quantityBefore Decimal     @db.Decimal(14, 3)
  quantityAfter  Decimal     @db.Decimal(14, 3)
  reason        String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime     @default(now())

  hotel     Hotel     @relation(fields: [hotelId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@index([hotelId, createdAt])
  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([referenceType, referenceId])
}

model CashRegister {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel    Hotel         @relation(fields: [hotelId], references: [id])
  sessions CashSession[]
  sales    Sale[]

  @@unique([hotelId, code])
}

model CashSession {
  id              String            @id @default(cuid())
  cashRegisterId  String
  openedById      String
  status          CashSessionStatus @default(OPEN)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  expectedCash    Decimal?          @db.Decimal(12, 2)
  countedCash     Decimal?          @db.Decimal(12, 2)
  cashDifference  Decimal?          @db.Decimal(12, 2)
  totalsByMethod  Json?
  notes           String?

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  openedBy     User         @relation(fields: [openedById], references: [id])
  sales        Sale[]

  @@index([cashRegisterId, status])
}

model Sale {
  id              String           @id @default(cuid())
  hotelId         String
  warehouseId     String
  cashierId       String
  cashRegisterId  String?
  cashSessionId   String?
  status          SaleStatus       @default(PENDING)
  subtotal        Decimal          @db.Decimal(12, 2)
  discountAmount  Decimal          @db.Decimal(12, 2) @default(0)
  taxAmount       Decimal          @db.Decimal(12, 2)
  total           Decimal          @db.Decimal(12, 2)
  currency        String
  discountType    SaleDiscountType @default(NONE)
  discountReason  String?
  voucherCode     String?
  roomReference   String?
  guestName       String?
  notes           String?
  transactionNo   String
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  cashier      User          @relation("SaleCashier", fields: [cashierId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  cashSession  CashSession?  @relation(fields: [cashSessionId], references: [id])
  items        SaleItem[]
  payments     Payment[]
  refunds      Refund[]

  @@unique([hotelId, transactionNo])
  @@index([hotelId, status, createdAt])
  @@index([cashierId, createdAt])
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  productId       String?
  posArticleId    String?
  recipeId        String?
  quantity        Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(12, 4)
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
  vatRate         Decimal @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(12, 2)
  nameSnapshot    String
  isComplimentary Boolean @default(false)

  sale       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id])
  posArticle PosArticle? @relation(fields: [posArticleId], references: [id])
  recipe     Recipe?     @relation(fields: [recipeId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([posArticleId])
  @@index([recipeId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  currency  String
  reference String?
  status    String        @default("COMPLETED")
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model Refund {
  id        String   @id @default(cuid())
  saleId    String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([saleId])
}

model InventoryCount {
  id          String                @id @default(cuid())
  hotelId     String
  warehouseId String?
  categoryId  String?
  name        String
  status      InventoryCountStatus  @default(DRAFT)
  createdById String
  startedAt   DateTime?
  closedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  hotel     Hotel            @relation(fields: [hotelId], references: [id])
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id])
  category  ProductCategory? @relation(fields: [categoryId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  items     InventoryCountItem[]

  @@index([hotelId, status])
}

model InventoryCountItem {
  id           String   @id @default(cuid())
  countId      String
  productId    String
  systemQty    Decimal  @db.Decimal(14, 3)
  countedQty   Decimal? @db.Decimal(14, 3)
  difference   Decimal? @db.Decimal(14, 3)
  valueDiff    Decimal? @db.Decimal(12, 2)
  countedAt    DateTime?

  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@unique([countId, productId])
  @@index([productId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String?
  hotelId        String?
  userId         String?
  accountType    AccountType?
  action         String
  entity         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ip             String?
  createdAt      DateTime     @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  hotel        Hotel?        @relation(fields: [hotelId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([hotelId, createdAt])
  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
}

// Phase 2+ stubs (minimal schema)

model PurchaseOrder {
  id         String   @id @default(cuid())
  hotelId    String
  supplierId String
  status     String   @default("DRAFT")
  orderedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hotel    Hotel               @relation(fields: [hotelId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@index([hotelId, status])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantityOrdered Decimal @db.Decimal(14, 3)
  unitPrice       Decimal @db.Decimal(12, 4)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  hotelId         String
  warehouseId     String
  supplierId      String
  purchaseOrderId String?
  deliveryNoteNo  String?
  status          String   @default("DRAFT") // DRAFT | CONFIRMED | CANCELLED
  receivedAt      DateTime @default(now())
  confirmedAt     DateTime?
  createdById     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel            Hotel              @relation(fields: [hotelId], references: [id])
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id])
  supplier         Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder    PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  items            GoodsReceiptItem[]
  deliveryNoteScan DeliveryNoteScan?

  @@index([hotelId, status])
  @@index([warehouseId])
  @@index([hotelId, supplierId, deliveryNoteNo])
}

enum DeliveryNoteScanStatus {
  CAPTURING
  PROCESSING
  REVIEW
  CONFIRMED
  FAILED
  CANCELLED
}

/// Multi-page Lieferschein scan session (OCR/AI → review → book to Lager).
model DeliveryNoteScan {
  id             String                 @id @default(cuid())
  hotelId        String
  status         DeliveryNoteScanStatus @default(CAPTURING)
  supplierId     String?
  deliveryNoteNo String?
  deliveryDate   DateTime?
  /// SHA-256 of concatenated page file hashes (duplicate detection)
  documentHash   String?
  ocrStatus      String? // SUCCESS | FAILED | PARTIAL
  ocrError       String?
  /// Full AI/OCR extraction payload
  ocrRawResult   Json?
  /// Review lines: recognized + matched + user corrections
  extractedLines Json?
  goodsReceiptId String?                @unique
  createdById    String?
  processedAt    DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  hotel        Hotel              @relation(fields: [hotelId], references: [id])
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  goodsReceipt GoodsReceipt?      @relation(fields: [goodsReceiptId], references: [id])
  pages        DeliveryNotePage[]

  @@index([hotelId, status])
  @@index([hotelId, documentHash])
  @@index([hotelId, supplierId, deliveryNoteNo])
  @@index([createdById])
}

model DeliveryNotePage {
  id        String   @id @default(cuid())
  scanId    String
  pageIndex Int
  imageUrl  String
  mimeType  String
  fileSize  Int
  fileHash  String
  createdAt DateTime @default(now())

  scan DeliveryNoteScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, pageIndex])
  @@index([scanId])
}

model GoodsReceiptItem {
  id             String   @id @default(cuid())
  goodsReceiptId String
  productId      String
  qtyOrdered     Decimal  @db.Decimal(14, 3)
  qtyDelivered   Decimal  @db.Decimal(14, 3)
  qtyDamaged     Decimal  @db.Decimal(14, 3) @default(0)
  qtyMissing     Decimal  @db.Decimal(14, 3) @default(0)
  purchasePrice  Decimal  @db.Decimal(12, 4)
  expiryDate     DateTime?
  batchNo        String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
}

model StockTransfer {
  id              String   @id @default(cuid())
  hotelId         String
  fromWarehouseId String
  toWarehouseId   String
  reason          String?
  createdAt       DateTime @default(now())

  hotel         Hotel               @relation(fields: [hotelId], references: [id])
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]
}

model StockTransferItem {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(14, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

model Recipe {
  id           String   @id @default(cuid())
  hotelId      String
  name         String
  version      Int      @default(1)
  isActive     Boolean  @default(true)
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotel      Hotel        @relation(fields: [hotelId], references: [id])
  items      RecipeItem[]
  posArticles PosArticle[]
  saleItems  SaleItem[]

  @@index([hotelId])
  @@index([hotelId, name])
}

model RecipeItem {
  id        String  @id @default(cuid())
  recipeId  String
  productId String
  quantity  Decimal @db.Decimal(14, 3)
  unit      Unit
  sortOrder Int     @default(0)

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([recipeId])
  @@index([productId])
}

enum PosArticleType {
  PRODUCT
  RECIPE
}

model PosCategory {
  id        String   @id @default(cuid())
  hotelId   String
  name      String
  code      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel    Hotel        @relation(fields: [hotelId], references: [id])
  articles PosArticle[]

  @@unique([hotelId, name])
  @@index([hotelId, sortOrder])
  @@index([hotelId, isActive])
}

model PosArticle {
  id            String         @id @default(cuid())
  hotelId       String
  type          PosArticleType
  productId     String?
  recipeId      String?
  posCategoryId String?
  name          String
  description   String?
  salePrice     Decimal        @db.Decimal(12, 4)
  vatRate       Decimal        @db.Decimal(5, 2) @default(8.1)
  imageUrl      String?
  sortOrder     Int            @default(0)
  isFavorite    Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  recipe       Recipe?       @relation(fields: [recipeId], references: [id])
  posCategory  PosCategory?  @relation(fields: [posCategoryId], references: [id])
  saleItems    SaleItem[]
  priceHistory PosPriceHistory[]

  @@index([hotelId, isActive, sortOrder])
  @@index([hotelId, type])
  @@index([hotelId, posCategoryId])
  @@index([productId])
  @@index([recipeId])
  @@unique([hotelId, productId])
  @@unique([hotelId, recipeId])
}

model PosPriceHistory {
  id           String   @id @default(cuid())
  posArticleId String
  hotelId      String
  userId       String?
  oldPrice     Decimal  @db.Decimal(12, 4)
  newPrice     Decimal  @db.Decimal(12, 4)
  createdAt    DateTime @default(now())

  posArticle PosArticle @relation(fields: [posArticleId], references: [id], onDelete: Cascade)

  @@index([posArticleId, createdAt])
  @@index([hotelId, createdAt])
}

model Waste {
  id         String   @id @default(cuid())
  hotelId    String
  productId  String
  quantity   Decimal  @db.Decimal(14, 3)
  reason     String
  costValue  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([hotelId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  hotelId   String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId, isRead, createdAt])
}

model BreakfastRecord {
  id               String   @id @default(cuid())
  hotelId          String
  date             DateTime @db.Date
  expectedGuests   Int      @default(0)
  actualGuests     Int      @default(0)
  costTotal        Decimal  @db.Decimal(12, 2) @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, date])
  @@index([hotelId, date])
}

model MinibarRecord {
  id          String   @id @default(cuid())
  hotelId     String
  roomNumber  String
  productId   String
  quantity    Decimal  @db.Decimal(14, 3)
  recordedById String?
  notes       String?
  createdAt   DateTime @default(now())

  hotel   Hotel   @relation(fields: [hotelId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([hotelId, roomNumber, createdAt])
  @@index([productId])
}
